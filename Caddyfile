# Lisans Yönetim Paneli — Caddy reverse proxy + otomatik TLS (MIMARI.md §1).
#
# Üretim: API_DOMAIN / ADMIN_DOMAIN gerçek alan adları → Caddy Let's Encrypt
# sertifikasını otomatik alır ve yeniler.
# Lokal: domainler "localhost" → Caddy iç TLS sertifikası üretir.
#
# ── ERİŞİM LOGU BİLEREK KAPALI (güvenlik) ───────────────────────────────────
# Caddy v2'de site erişim logu `log` direktifi olmadan ÜRETİLMEZ; burada bilerek yok
# (canlıda doğrulandı: trafik varken caddy container'ı 2 dakikada 0 istek satırı yazdı).
#
# NEDEN ÖNEMLİ: panelde lisans envanteri araması TAM anahtar kabul eder ve arama query
# string'de taşınır (`?search=XXXXX-…`). API tarafı bunu pino serializer'ında maskeler
# (`observability/log-redact.ts` → `search=[gizlendi]`), ama Caddy erişim logu AÇILIRSA
# ham URL'i yazar ve maskeleme oraya UYGULANMAZ — payload'lar AES-256-GCM ile şifreli
# dururken anahtar düz metin olarak log dosyasına düşer.
#
# Log açmak gerekirse (tanı/denetim): sorgu dizesini logdan ÇIKAR, ör.
#   log {
#     output stdout
#     format filter {
#       request>uri query {
#         delete search
#         delete q
#         delete token
#       }
#     }
#   }
# ya da en azından `request>uri` alanını tamamen `delete` et.

{$ADMIN_DOMAIN} {
	encode gzip zstd
	reverse_proxy admin:3000
}

{$API_DOMAIN} {
	encode gzip zstd

	# key/sır yanıtları asla cache'lenmez (§7).
	header {
		Cache-Control "no-store"
		-Server
	}

	reverse_proxy api:3001
}

# ── İZOLE DEV/STAGING alt alan adları (env-gated) ────────────────────────────
# DEV_*_DOMAIN prod .env'de gerçek subdomain'e ayarlanırsa aktif; ayarlanmazsa
# *.localhost'a düşer (iç sertifika, dış etki YOK). Upstream'ler lisansdev projesinin
# container'larıdır — prod Caddy'nin `lisansdev_default` ağına bağlı olması gerekir
# (bunu `dev-stack.sh subdomains` yapar — `up` DEĞİL; ağ bağlama o alt komutta, dev-stack.sh:85-94).
# Bağlı değilse yalnız bu rotalar 502 verir; PROD ETKİLENMEZ.
{$DEV_ADMIN_DOMAIN:dev-admin.localhost} {
	encode gzip zstd
	reverse_proxy lisansdev-admin-1:3000
}

{$DEV_API_DOMAIN:dev-api.localhost} {
	encode gzip zstd
	header {
		Cache-Control "no-store"
		-Server
	}
	reverse_proxy lisansdev-api-1:3001
}

{$DEV_WP_DOMAIN:dev-wp.localhost} {
	encode gzip zstd
	reverse_proxy lisansdev-wordpress-1:80
}
