# ─────────────────────────────────────────────────────────────
# Lisans Yönetim Paneli — ortam değişkenleri örneği
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# .env ASLA commit edilmez (.gitignore'da).
# ─────────────────────────────────────────────────────────────

# Genel
NODE_ENV=development
# Zaman dilimi — API konteyneri + JS tarih yerelleştirmesi (günlük digest toLocaleDateString,
# valid_until vb.) PG ile aynı TZ'de olsun diye. Varsayılan Europe/Istanbul.
TZ=Europe/Istanbul

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=lisanspanel
POSTGRES_PASSWORD=degistir_beni_guclu_parola
POSTGRES_DB=lisanspanel
# Uygulama bağlantısı (compose içinde host = "postgres")
DATABASE_URL=postgres://lisanspanel:degistir_beni_guclu_parola@postgres:5432/lisanspanel
# Lokal (Docker dışı) çalıştırma için:
# DATABASE_URL=postgres://lisanspanel:degistir_beni_guclu_parola@localhost:5432/lisanspanel

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Lokal: redis://localhost:6379

# ── API ─────────────────────────────────────────────────────
API_PORT=3001
# Payload şifreleme master anahtarı (AES-256-GCM envelope).
# 32 byte base64. Üretim: `openssl rand -base64 32`
# ÜRETİMDE bu değer DB yedeğinden AYRI secret store'da tutulur.
MASTER_KEY=

# Admin uçları (site/ürün/stok yönetimi) için yönetici token'ı.
# Üret: openssl rand -hex 24
ADMIN_TOKEN=

# WP eklenti güncelleyicisinin indireceği .zip mutlak URL tabanı (§16). BOŞSA istek host'undan
# türetilir (tek Caddy arkasında yeterli). CDN/çoklu-proxy topolojisinde gerçek dış API URL'ini verin.
PUBLIC_API_URL=

# İlk admin bootstrap (§8) — admin_users tablosu BOŞSA açılışta bir "owner" admin
# oluşturulur. Sonraki adminler panelden eklenir. İkisi de gerekli (opsiyonel özellik).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Yönetici
ADMIN_SEED_USERNAME=

# ── Admin (Next.js) ─────────────────────────────────────────
ADMIN_PORT=3000
# Admin SUNUCU-TARAFI API tabanı (server component / route handler → panel API). Admin API'ye
# yalnız sunucu tarafından erişir. Compose bunu http://api:3001 olarak enjekte eder; Docker dışı
# lokal çalıştırmada:
API_URL=http://localhost:3001
# Panelde gösterilen sürüm. Opsiyonel — boşsa admin /settings kendi package.json sürümünü
# gösterir. (Yalnız yorum satırı olarak duruyordu; atanabilir bir satırı olmadığı için
# operatör bunun ayarlanabilir olduğunu göremiyordu — bkz. scripts/check-env-passthrough.js.)
APP_VERSION=
# NOT: NEXT_PUBLIC_API_URL şu an KULLANILMIYOR (tarayıcı-taraflı erişim yok); ileride ayrılmıştır.
# Oturum imza sırrı (§8). SET EDİLİRSE çoklu-admin auth AKTİF olur → /login zorunlu,
# kimlik admin_users'a karşı doğrulanır. BOŞ = auth kapalı (panel herkese açık!).
# Üret: openssl rand -hex 32. İlk admin için ayrıca ADMIN_SEED_* (yukarıda) verin.
# GÜVENLİK (denetim): min 24 karakter zorunludur — SET edilmiş ama daha kısa bir değer
# admin uygulamasını FAIL-CLOSED durdurur (zayıf imza anahtarıyla oturum taklidi önlenir).
SESSION_SECRET=
# Auth ZORUNLU mu? (fail-closed opt-in, denetim P1) true/1 ise SESSION_SECRET tanımsızken panel
# istekleri 503 döner (prod'da yanlışlıkla "auth kapalı" deploy'u LOUD yakalar). Boş/unset =
# eski davranış (dev/izole ortam açık kalır, UI uyarı bandı gösterir). ÜRETİMDE true önerilir.
REQUIRE_AUTH=

# ── Mail / SMTP (teslimat bildirimleri) ─────────────────────
# Dev: Mailpit (compose'ta SMTP_HOST=mailpit, SMTP_PORT=1025, TLS'siz) — override gerekmez.
# ÜRETİM: gerçek SMTP relay bilgilerini buradan verin.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Üretimde TLS için "true" (587/465). Dev Mailpit TLS'siz olduğu için "false".
SMTP_SECURE=false
# Gönderen adresi (görünen ad + adres). Üretimde kendi domaininizi kullanın.
MAIL_FROM=Lisans Paneli <teslimat@localhost>
# SMTP kimlik doğrulama (SendGrid/SES/Mailgun/Gmail vb. kimlik isteyen relay'ler için).
# İKİSİ de boşsa transport'a auth EKLENMEZ (kimliksiz relay/Mailpit). Verildiyse otomatik bağlanır.
SMTP_USER=
SMTP_PASS=

# ── Telegram bildirim (opsiyonel, env-gated) ────────────────
# Düşük stok / kritik olay bildirimleri için (§12). İKİSİ de boşsa gönderim no-op
# (özellik kapalı, panel içi bildirim akışı yine çalışır). BotFather'dan token alın,
# chat_id'yi @userinfobot veya getUpdates ile öğrenin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Günlük digest eşikleri (opsiyonel, §16) ─────────────────
# Günlük operasyon özeti (her gün 08:00) sabit-eşik kritik alarm üretir: metrik eşiği aşarsa
# NotificationsService → warning/critical Telegram yolu. Verilmezse kod içi varsayılan kullanılır.
# Sorunlu (dead-letter) webhook sayısı bu değere ULAŞIRSA kritik alarm (varsayılan 5).
DIGEST_FAILED_OUTBOX_THRESHOLD=5
# 24 saatteki güvenlik olayı sayısı bu değere ULAŞIRSA kritik alarm (varsayılan 20).
DIGEST_SECURITY_EVENTS_THRESHOLD=20
# Atanabilir stok bu değere İNER/altına geçerse kritik alarm (varsayılan 5).
DIGEST_LOW_STOCK_THRESHOLD=5

# ── AI-destekli operasyon (opsiyonel, env-gated, §15) ───────
# VARSAYILAN KAPALI. AI_ENABLED=true VE ANTHROPIC_API_KEY birlikte SET EDİLİRSE AI uçları
# (triyaj önerisi, NL→SQL rapor, günlük anomali paragrafı) açılır; aksi halde bu uçlar 503 döner
# ve sistem AI'sız tam çalışır. ANTHROPIC_API_KEY bir KULLANICI sırrıdır — repoya YAZILMAZ.
AI_ENABLED=false
ANTHROPIC_API_KEY=
# Kullanılacak model (opsiyonel; boşsa kod içi varsayılan: claude-opus-4-8).
AI_MODEL=
# Anthropic API taban URL'i (opsiyonel; boşsa https://api.anthropic.com). Proxy/gateway için.
AI_BASE_URL=

# ── Caddy / domain ──────────────────────────────────────────
# Üretimde gerçek domainler; lokalde otomatik iç TLS.
# ÖNEMLİ: iki domain ASLA aynı olamaz — Caddy "ambiguous site definition" verir.
# Lokalde admin=localhost, api=api.localhost (*.localhost loopback'e çözülür).
ADMIN_DOMAIN=localhost
API_DOMAIN=api.localhost

# ── Gözlem (opsiyonel, Faz 0'da boş bırakılabilir) ──────────
# Sentry hata izleme (§16) — env-gated, VARSAYILAN KAPALI. SENTRY_DSN boşsa SDK init edilmez
# (tam no-op, sistem etkilenmez). Etkinleştirmek için Sentry projesinden DSN'i buraya yaz
# (DSN kullanıcı sırrıdır). SENTRY_ENVIRONMENT opsiyonel etiket (yoksa NODE_ENV kullanılır).
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ── Dayanıklılık / performans ayarları (opsiyonel — hepsi cömert varsayılana sahip) ──
# Bu değişkenlerin HİÇBİRİ zorunlu değildir; boş bırakılırsa aşağıdaki varsayılan uygulanır.
# Fault-injection + stres testleriyle belirlenen sertleştirme parametreleri.

# Site-facing HMAC uçlarında IP başına dakikalık BAŞARISIZ kimlik-doğrulama tavanı. YALNIZ auth-FAIL
# (geçersiz api_key/imza) sayılır → meşru mağaza (imzası hep geçerli) ASLA kısıtlanmaz; yalnız
# geçersiz-imza seli, DB'ye inmeden 429 yer. Meşru mağaza normalde 0 başarısızlık üretir. Varsayılan 120.
HMAC_IP_FAIL_LIMIT=120

# Stok import'unda SENKRON (inline) tamamlanacak en fazla bekleyen satır. Fazlası arka plana
# (BullMQ) atılır → büyük backlog'da import isteği dakikalarca asılmaz. Varsayılan 200.
AUTOCOMPLETE_INLINE_CAP=200

# ── Veri saklama / budama (retention) — RetentionService (günlük) ──
# Eski kayıtları batch'ler halinde budar/maskeler (sınırsız büyümeyi + KVKK PII saklamayı önler).
# Gün cinsinden; boş bırakılırsa varsayılan. 0/boş bazı alanlarda "kapalı" demektir (aşağıda).
RETENTION_FULFILLMENT_DAYS=180      # fulfillment_events: bu günden eski SİL
RETENTION_OUTBOX_DAYS=30            # outbox_events (yalnız status='delivered'): bu günden eski SİL
RETENTION_SECURITY_DAYS=365         # security_events: bu günden eski SİL
RETENTION_EMAIL_MASK_DAYS=365       # email_log: bu günden eski to_email'i MASKELE (KVKK)
RETENTION_EMAIL_DELETE_DAYS=730     # email_log: bu günden eski satırı SİL
RETENTION_AUDIT_REVEAL_DAYS=90      # audit_log: yalnız otomatik 'reveal' (görüntüleme) gürültüsünü SİL
RETENTION_AUDIT_ALL_DAYS=           # audit_log: boş=KAPALI. Set edilirse o günden eski TÜM audit'i SİL (dikkat: uyum kaydı)
RETENTION_NOTIFICATION_DAYS=180     # notifications: OKUNMUŞ + bu günden eski SİL (okunmamış uyarı DURUR)
RETENTION_NOTIFICATION_ALL_DAYS=    # notifications: boş=KAPALI. Set edilirse okunmamışlar dahil TÜM eski satırları SİL
RETENTION_DEPLOYMENT_DAYS=365       # deployments: yalnız success/failed + bu günden eski SİL (pending/running ASLA)
RETENTION_CONNECT_TOKEN_DAYS=7      # site_connect_tokens: tüketilmiş/süresi geçmiş + bu günden eski SİL

# Mutabakat (reconcile) sıcak-yol zaman penceresi. Her 15dk son N günü tarar (tam-tablo yerine).
RECONCILE_WINDOW_DAYS=30
# true → pencereyi kaldır (TAM tablo reconcile). Haftalık tam koşu için CI/cron'da kullanılabilir.
RECONCILE_FULL=false
# Sweep (expiry/reconcile/retention) HATA alarmı dedupe penceresi (saat). Aynı kuyruk için tekrar
# alarmı bu süre içinde bastırılır (spam olmasın). Varsayılan 6.
SWEEP_ALARM_DEDUPE_HOURS=6

# Mağaza SESSİZLİK eşiği (saat). Bir mağaza bu süre boyunca panele imzalı istek göndermediyse
# bildirim üretilir (30dk'da bir taranır). Geçmişte gerçek bir kesinti GÜNLERCE fark edilmedi:
# eklenti hiç istek göndermiyordu ama panel "sağlıklı" görünüyordu, çünkü sessizliği ölçen bir
# sinyal yoktu. HİÇ bağlanmamış (kurulum aşamasındaki) site alarm konusu DEĞİLDİR — yalnız
# ekranda gösterilir. Varsayılan 24.
SITE_SILENCE_HOURS=24

# ── Yedekleme (scripts/backup-runner.sh + backup-drill.sh; §16 / RUNBOOK-DR) ──
# Bu değişkenleri PANEL DEĞİL, VPS host'undaki runner betiği okur (panel konteynerine Docker
# soketi verilmez — panel yalnız kuyruğa istek yazar, çalıştıran host runner'ıdır).
# Dump hedef dizini (varsayılan: <repo>/backups).
BACKUP_DIR=
# Kaç dump saklanacak. Runner varsayılanı 14 (elle koşumda 0 = hepsini tut). Disk planı:
# yaklaşık `BACKUP_KEEP_LAST × dump boyutu` yer gerekir (boyut panelde /deployments'ta görünür).
BACKUP_KEEP_LAST=
# DIŞ KOPYA KANCASI (kritik). BOŞSA yedek YALNIZ bu sunucuda kalır — sunucu kaybı = veri kaybı.
# Dump yolunu TEK argüman olarak alan bir komut/betik verin (eval YOK; metakarakter yorumlanmaz):
#   BACKUP_OFFSITE_CMD=/usr/local/bin/offsite-upload.sh
# Hedef sizin kontrolünüzde değilse dump'ı sarmalayıcıda ŞİFRELEYİN. Reçete: docs/RUNBOOK-DR.md §4.4.
BACKUP_OFFSITE_CMD=
# Dış kopya komutu için saniye üst sınırı (varsayılan 900). Kanca takılırsa iş burada kesilir.
BACKUP_OFFSITE_TIMEOUT=
# HATIRLATMA: MASTER_KEY bu yedeklerin İÇİNDE DEĞİLDİR (payload'lar onunla şifreli). Ayrı bir
# kasada, çevrimdışı en az iki kopya tutun — yoksa yedek geri yüklense bile payload'lar açılamaz.
