{
  "name": "lisans-panel",
  "version": "1.1.0",
  "private": true,
  "description": "Lisans Yönetim Paneli — merkezi lisans dağıtım paneli (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "check:use-server": "node scripts/check-use-server.js",
    "check:nest-wiring": "node scripts/check-nest-wiring.js",
    "check:env": "node scripts/check-env-passthrough.js",
    "check:workflows": "node scripts/check-workflows.js",
    "check:tx-pool": "node scripts/check-tx-pool.js",
    "typecheck": "turbo run typecheck && node scripts/check-use-server.js && node scripts/check-nest-wiring.js && node scripts/check-env-passthrough.js && node scripts/check-workflows.js && node scripts/check-tx-pool.js",
    "test": "turbo run test",
    "test:race": "turbo run test:race --filter=@lisans/api",
    "test:integration": "turbo run test:integration --filter=@lisans/api",
    "test:iso": "bash scripts/test-integration.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @lisans/api db:generate",
    "db:migrate": "pnpm --filter @lisans/api db:migrate",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f api admin",
    "wp:dev": "bash scripts/wp-dev.sh",
    "wp:down": "docker compose -f docker-compose.wp.yml down",
    "wp:cli": "docker compose -f docker-compose.wp.yml exec wpcli wp"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "js-yaml": "^4.3.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "postcss": "^8.5.26",
      "nanoid@^3": "^3.3.18",
      "fast-uri@^3": "^3.1.5",
      "fast-uri@^4": "^4.1.2",
      "find-my-way": "^9.7.0",
      "sharp": "^0.35.3",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^5": "^5.0.9",
      "js-yaml@^4": "^4.3.1"
    }
  }
}
