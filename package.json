{
  "name": "lisans-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Lisans Yönetim Paneli — merkezi lisans dağıtım paneli (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:race": "turbo run test:race --filter=@lisans/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @lisans/api db:generate",
    "db:migrate": "pnpm --filter @lisans/api db:migrate",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f api admin",
    "wp:dev": "bash scripts/wp-dev.sh",
    "wp:down": "docker compose -f docker-compose.wp.yml down",
    "wp:cli": "docker compose -f docker-compose.wp.yml exec wpcli wp"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
